# Angel Perú IPTV — Creado por Angel Perú
# Genera AP_ACCESS_TOKEN con un generador seguro de 32+ bytes aleatorios.
AP_ACCESS_TOKEN=REEMPLAZA_POR_UN_SECRETO_ALEATORIO_LARGO
# Dominios exactos de los proveedores que tienes autorización para consultar.
# Ejemplo de formato: proveedor-ejemplo.com,api.proveedor-ejemplo.net
ALLOWED_SOURCE_HOSTS=
# Mantén false siempre que el proveedor tenga HTTPS.
# Si el proveedor autorizado solo ofrece HTTP, cambia a true conscientemente.
ALLOW_HTTP_SOURCES=false
